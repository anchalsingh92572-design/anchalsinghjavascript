/* =========================================
   4. SCOPE
========================================= */
// Global Scope
let college = "United University";

function show() {
    console.log(college);
}
show();

// Function Scope
function test() {
    let num = 10;
    console.log(num);
}
test();
// console.log(num); // Error

// Block Scope
if (true) {
    let p = 10;
    const q = 20;
    console.log(p);
    console.log(q);
}
// console.log(p); // Error

// var vs let
if (true) {
    var m = 10;
    let n = 20;
}
console.log(m);
// console.log(n); // Error


/* =========================================
   5. SCOPE CHAIN
========================================= */
let collegeName = "United University";

function teacher() {
    let subject = "JavaScript";

    function lecture() {
        let topic = "Scope";
        console.log(collegeName);
        console.log(subject);
        console.log(topic);
    }

    lecture();
}
teacher();


