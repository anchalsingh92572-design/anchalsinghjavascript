console.log(!isStudent);


/* =========================================
   13. IF STATEMENT
========================================= */
let marks = 75;

if (marks >= 40) {
    console.log("Pass");
}


/* =========================================
   14. IF...ELSE STATEMENT
========================================= */
let marks2 = 35;

if (marks2 >= 40) {
    console.log("Pass");
} else {
    console.log("Fail");
}


/* =========================================
   15. ELSE IF STATEMENT
========================================= */
let marks3 = 78;

if (marks3 >= 90) {
    console.log("A+");
} else if (marks3 >= 75) {
    console.log("A");
} else if (marks3 >= 60) {
    console.log("B");
} else if (marks3 >= 40) {
    console.log("C");
} else {
    console.log("Fail");
}


/* =========================================
   16. TERNARY OPERATOR
========================================= */
// Using if...else
let age1 = 20;

if (age1 >= 18) {
    console.log("Adult");
} else {
    console.log("Minor");
}

// Using Ternary Operator
let result1 = age1 >= 18 ? "Adult" : "Minor";
console.log(result1);


/* =========================================
   17. SWITCH STATEMENT
========================================= */
let day = 2;

switch (day) {
    case 1:
        console.log("Monday");
        break;

    case 2:
        console.log("Tuesday");
        break;

    case 3:
        console.log("Wednesday");
        break;

    default:
        console.log("Invalid day");
}


/* =========================================
   18. FOR LOOP
========================================= */
// Print 1 to 5
for (let i = 1; i <= 5; i++) {
    console.log(i);
}

// Print even numbers from 1 to 10
for (let i = 1; i <= 10; i++) {
    if (i % 2 == 0) {
        console.log(i);
    }
}


/* =========================================
   19. WHILE LOOP
========================================= */
let i = 1;

while (i <= 5) {
    console.log(i);
    i++;
}


/* =========================================
   20. DO...WHILE LOOP
========================================= */
// Print 1 to 5
let j = 1;

do {
    console.log(j);
    j++;
} while (j <= 5);

// Difference between while and do...while
let k = 10;

while (k < 5) {
    console.log(k);
}

// do...while executes at least once
let l = 10;

do {
    console.log(l);
} while (l < 5);


/* =========================================
   21. BREAK STATEMENT
========================================= */
for (let i = 1; i <= 10; i++) {
    if (i == 5) {
        break;
    }
    console.log(i);
}


/* =========================================
   22. CONTINUE STATEMENT
========================================= */
for (let i = 1; i <= 5; i++) {
    if (i == 3) {
        continue;
    }
    console.log(i);
}


